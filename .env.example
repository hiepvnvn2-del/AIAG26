# ===== LLM (multi-key rotation wrapper) =====
GEMINI_API_KEYS=key_1_here,key_2_here,key_3_here
GEMINI_MODEL=gemini-2.0-flash

# ===== Telegram HITL =====
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789
# Set to 0 for the stage demo: callbacks come from the dashboard instead of Telegram.
TELEGRAM_ENABLED=1

# ===== Browser =====
HEADLESS=false
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
ACTION_TIMEOUT_MS=10000

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Safety =====
# Global ceiling on any single price change the system may stage (VND).
MAX_PRICE_DELTA_PCT=30